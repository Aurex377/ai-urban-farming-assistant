# ====================================================================
# GrowWise AI — Backend Environment Configuration
# ====================================================================

# 1. Supabase Project Credentials (required)
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# 2. Development User Configuration
# UUID representing the active gardener in development mode
DEV_USER_ID=27865d2c-302e-4a2d-83aa-c1c9ea7338a4

# 3. CORS Configuration
# Allowed origin for React frontend (Vite defaults to 5173)
FRONTEND_URL=http://localhost:5173

# 4. NVIDIA Nemotron AI Model Configuration (Phase 2 & Phase 4)
# Obtain API key from: https://build.nvidia.com (NVIDIA NIM)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_VISION_MODEL_NAME=meta/llama-3.2-11b-vision-instruct
NVIDIA_TIMEOUT_SECONDS=60

# 5. Legacy Local Vision Model Configuration (Deprecated)
LLAVA_API_URL=http://localhost:11434
LLAVA_MODEL_NAME=llava
LLAVA_TIMEOUT_SECONDS=45
LLAVA_AUTO_PROCESS=true
